{
  "name": "backend-technical-test-ravi-zarazka-putra",
  "version": "1.0.0",
  "description": "Inventory Procurement API — Backend Engineer take-home technical test",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seeders/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravizp/backend-technical-test-ravi-zarazka-putra.git"
  },
  "keywords": [
    "inventory",
    "procurement",
    "hono",
    "drizzle",
    "postgresql",
    "typescript"
  ],
  "author": "ravizp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ravizp/backend-technical-test-ravi-zarazka-putra/issues"
  },
  "homepage": "https://github.com/ravizp/backend-technical-test-ravi-zarazka-putra#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
